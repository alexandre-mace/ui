      "description": "Case à cocher accessible sur base react-aria-components.",
      "dependencies": [
        "react-aria-components"
      ],
      "files": [
        {
          "path": "src/components/alexandremace/checkbox.tsx",
          "type": "registry:ui",
          "target": "components/ui/checkbox.tsx"
        }
      ]
    }
  ]
}