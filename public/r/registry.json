{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "alexandremace",
  "homepage": "https://ui.alexandremace.fr",
  "items": [
    {
      "name": "theme",
      "type": "registry:theme",
      "title": "Alexandre Macé",
      "description": "Thème de base : fond sable, bleu #0737FF, thème clair unique. Chaque projet peut surcharger ses tokens d'identité. Police : Geist via le paquet npm geist (reco Vercel).",
      "css": {
        "@theme inline": {
          "--font-sans": "var(--font-geist-sans), system-ui, sans-serif",
          "--font-mono": "var(--font-geist-mono), monospace"
        },
        "@layer base": {
          "body": {
            "-webkit-font-smoothing": "antialiased",
            "-moz-osx-font-smoothing": "grayscale"
          }
        }
      },
      "cssVars": {
        "light": {
          "radius": "0.625rem",
          "background": "#FAF8F0",
          "foreground": "oklch(0.145 0 0)",
          "card": "#FDFCF8",
          "card-foreground": "oklch(0.145 0 0)",
          "popover": "#FDFCF8",
          "popover-foreground": "oklch(0.145 0 0)",
          "primary": "#0737FF",
          "primary-foreground": "oklch(0.985 0 0)",
          "secondary": "oklch(0.97 0.008 90)",
          "secondary-foreground": "oklch(0.205 0 0)",
          "muted": "oklch(0.95 0.01 90)",
          "muted-foreground": "oklch(0.4 0.015 80)",
          "accent": "oklch(0.95 0.01 90)",
          "accent-foreground": "oklch(0.205 0 0)",
          "destructive": "oklch(0.577 0.245 27.325)",
          "border": "oklch(0.9 0.015 88)",
          "input": "oklch(0.9 0.015 88)",
          "ring": "#0737FF",
          "chart-1": "oklch(0.646 0.222 41.116)",
          "chart-2": "oklch(0.6 0.118 184.704)",
          "chart-3": "oklch(0.398 0.07 227.392)",
          "chart-4": "oklch(0.828 0.189 84.429)",
          "chart-5": "oklch(0.769 0.188 70.08)"
        }
      }
    },
    {
      "name": "button",
      "type": "registry:ui",
      "title": "Button",
      "description": "Button et LinkButton sur base react-aria-components (style aria-nova). Écart au stock : variant outline sur bg-card.",
      "dependencies": [
        "react-aria-components",
        "class-variance-authority"
      ],
      "files": [
        {
          "path": "src/components/alexandremace/button.tsx",
          "type": "registry:ui",
          "target": "components/ui/button.tsx"
        }
      ]
    },
    {
      "name": "input",
      "type": "registry:ui",
      "title": "Input",
      "description": "Champ de saisie sur base react-aria-components. Écart au stock : halo de focus adouci (ring-ring/25), la bordure ring garde le signal.",
      "dependencies": [
        "react-aria-components"
      ],
      "files": [
        {
          "path": "src/components/alexandremace/input.tsx",
          "type": "registry:ui",
          "target": "components/ui/input.tsx"
        }
      ]
    },
    {
      "name": "switch",
      "type": "registry:ui",
      "title": "Switch",
      "description": "Interrupteur accessible sur base react-aria-components.",
      "dependencies": [
        "react-aria-components"
      ],
      "files": [
        {
          "path": "src/components/alexandremace/switch.tsx",
          "type": "registry:ui",
          "target": "components/ui/switch.tsx"
        }
      ]
    },
    {
      "name": "slider",
      "type": "registry:ui",
      "title": "Slider",
      "description": "Curseur sur base react-aria-components. Écart au stock : piste plus visible (h-1.5, neutral-300/70) et poignée size-4.",
      "dependencies": [
        "react-aria-components"
      ],
      "files": [
        {
          "path": "src/components/alexandremace/slider.tsx",
          "type": "registry:ui",
          "target": "components/ui/slider.tsx"
        }
      ]
    },
    {
      "name": "tabs",
      "type": "registry:ui",
      "title": "Tabs",
      "description": "Onglets segmentés avec navigation clavier, sur base react-aria-components.",
      "dependencies": [
        "react-aria-components",
        "class-variance-authority"
      ],
      "files": [
        {
          "path": "src/components/alexandremace/tabs.tsx",
          "type": "registry:ui",
          "target": "components/ui/tabs.tsx"
        }
      ]
    },
    {
      "name": "badge",
      "type": "registry:ui",
      "title": "Badge",
      "description": "Étiquette de métadonnée.",
      "dependencies": [
        "class-variance-authority"
      ],
      "files": [
        {
          "path": "src/components/alexandremace/badge.tsx",
